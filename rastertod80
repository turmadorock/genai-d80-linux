#!/usr/bin/python3 -I
# rastertod80 - filtro CUPS para GENAI / Luck Jingle D80 (A4 térmica, 203 dpi, cabeça de 1728 pontos)
# Lê CUPS raster (1 ou 8 bits, cinza) e envia ESC/POS "GS v 0" sempre na largura total da cabeça.
#  - Centraliza a página na cabeça de 216 mm e aplica o deslocamento horizontal
#    da opção Horizontal (-20..+20 mm), lida do trabalho ou do padrão da fila.
#  - Remove linhas em branco no fim da página (opção SavePaper=No desliga isso).
import os, sys, struct

HEAD = 1728                    # pontos na cabeça (216 mm a 203 dpi)
HEAD_B = HEAD // 8
DPMM = 203 / 25.4
CHUNK = 128                    # linhas por bloco GS v 0
FULL = (1 << HEAD) - 1


def log(m):
    sys.stderr.write("DEBUG: rastertod80: %s\n" % m)


def rd(f, n):
    b = f.read(n)
    return b if len(b) == n else None


def pages(f):
    sync = rd(f, 4)
    if sync is None:
        return
    if sync in (b'RaS2', b'RaS3'):
        end = '>'
    elif sync in (b'2SaR', b'3SaR'):
        end = '<'
    else:
        sys.stderr.write("ERROR: rastertod80: formato raster nao suportado %r\n" % sync)
        sys.exit(1)
    compressed = sync in (b'RaS2', b'2SaR')
    while True:
        hdr = rd(f, 1796)
        if hdr is None:
            return
        u = lambda off: struct.unpack(end + 'I', hdr[off:off + 4])[0]
        width, height = u(372), u(376)
        bpp, bpl, cspace = u(388), u(392), u(400)
        ints = [u(452 + 4 * i) for i in range(16)]
        clear = 0xff if cspace in (0, 1, 18) else 0x00
        rows = []
        if not compressed:
            for _ in range(height):
                r = rd(f, bpl)
                if r is None:
                    return
                rows.append(r)
        else:
            unit = max(1, bpp // 8)
            while len(rows) < height:
                rep = f.read(1)
                if not rep:
                    return
                line = bytearray()
                while len(line) < bpl:
                    c = f.read(1)
                    if not c:
                        return
                    c = c[0]
                    if c == 128:
                        line += bytes([clear]) * (bpl - len(line))
                    elif c < 128:
                        line += rd(f, unit) * (c + 1)
                    else:
                        line += rd(f, unit * (257 - c))
                line = bytes(line[:bpl])
                rows.extend([line] * min(rep[0] + 1, height - len(rows)))
        yield width, bpp, cspace, ints, rows


def black_int(row, width, bpp, cspace):
    """Linha como inteiro de 'width' bits, bit mais alto = ponto 0, 1 = preto."""
    white_is_one = cspace in (0, 18)          # W / sW
    if bpp == 1:
        v = int.from_bytes(row, 'big') >> (len(row) * 8 - width)
        if white_is_one:
            v ^= (1 << width) - 1
        return v
    if bpp == 8:
        if white_is_one:
            bits = ''.join('1' if b < 128 else '0' for b in row[:width])
        else:
            bits = ''.join('1' if b >= 128 else '0' for b in row[:width])
        return int(bits, 2) if bits else 0
    sys.stderr.write("ERROR: rastertod80: %d bits por ponto nao suportado\n" % bpp)
    sys.exit(1)


def place(v, width, shift):
    """Põe a linha na cabeça começando no ponto 'shift' (negativo corta à esquerda)."""
    e = HEAD - width - shift
    v = v << e if e >= 0 else v >> -e
    return (v & FULL).to_bytes(HEAD_B, 'big')


def options():
    """Opções: padrão gravado no PPD da fila (lpadmin -o) e, por cima, as do trabalho (lp -o)."""
    opts = {'Horizontal': '0', 'SavePaper': 'Yes'}
    try:
        for line in open(os.environ.get('PPD', ''), encoding='latin-1'):
            for k in opts:
                if line.startswith('*Default%s:' % k):
                    opts[k] = line.split(':', 1)[1].strip()
    except OSError:
        pass
    if len(sys.argv) > 5:
        for item in sys.argv[5].split():
            k, _, v = item.partition('=')
            if k in opts and v:
                opts[k] = v
    try:
        off = max(-20, min(20, int(opts['Horizontal'])))
    except ValueError:
        off = 0
    return off, opts['SavePaper'].lower() not in ('no', 'false', 'nao')


def main():
    out = sys.stdout.buffer
    f = open(sys.argv[6], 'rb') if len(sys.argv) > 6 else sys.stdin.buffer
    off_mm, save_paper = options()
    out.write(b'\x1b@')
    n = 0
    for width, bpp, cspace, ints, rows in pages(f):
        n += 1
        shift = (HEAD - width) // 2 + round(off_mm * DPMM)
        log("pagina %d: %dx%d bpp=%d cspace=%d ajuste=%+d mm inicio=ponto %d"
            % (n, width, len(rows), bpp, cspace, off_mm, shift))
        lines = [place(black_int(r, width, bpp, cspace), width, shift) for r in rows]
        if save_paper:
            while lines and not any(lines[-1]):
                lines.pop()
        for i in range(0, len(lines), CHUNK):
            blk = lines[i:i + CHUNK]
            out.write(b'\x1dv0\x00' + struct.pack('<HH', HEAD_B, len(blk)) + b''.join(blk))
        out.write(b'\x1bJ\x60')            # ~12 mm de avanço entre páginas
        out.flush()
    out.write(b'\x1bd\x02')
    out.flush()
    log("%d pagina(s) enviadas" % n)


if __name__ == '__main__':
    main()
